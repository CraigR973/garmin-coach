# =============================================================================
# Garmin Coach — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# Postgres connection string for SQLAlchemy (asyncpg driver)
# Format: postgresql+asyncpg://user:password@host:port/dbname
# Supabase on Railway: use the session-mode pooler, port 5432.
# Do not use the direct db.* host from Railway (IPv6/IPv4 mismatch), and do not
# use transaction mode / port 6543 with asyncpg prepared statements.
#   postgresql+asyncpg://postgres.<project-ref>:<password>@aws-1-eu-north-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/garmin_coach

# Connection-pool sizing, bounded by what the pooler grants (Batch 232.3).
# Supabase's session-mode pooler caps this tenant at DB_POOLER_CLIENT_LIMIT
# client connections and refuses the next one outright with
# "(EMAXCONNSESSION) max clients reached in session mode". The API is not the
# only client of that budget — the weekly-review cron container runs the same
# code with its own engine, every deploy runs `alembic upgrade head` at boot,
# the nightly pg_dump opens a connection, and `railway run` / `railway ssh`
# sessions add more — so DB_POOLER_RESERVED_CONNECTIONS is held back for them.
# The app refuses to start if DB_POOL_SIZE + DB_MAX_OVERFLOW exceeds what is
# left. Raise the limit here only if the pooler's own setting is raised too.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOLER_CLIENT_LIMIT=15
DB_POOLER_RESERVED_CONNECTIONS=5

# -----------------------------------------------------------------------------
# Supabase (optional — only needed if using Supabase client directly)
# -----------------------------------------------------------------------------

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# Web Push (VAPID)
# -----------------------------------------------------------------------------

# VAPID public key — used by backend to sign push requests
VAPID_PUBLIC_KEY=your-vapid-public-key

# VAPID public key — VITE_ prefix exposes it to the React frontend for push subscription
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# VAPID private key — backend only
VAPID_PRIVATE_KEY=your-vapid-private-key

# Contact email for VAPID (shown to push services)
VAPID_CONTACT_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------

# Allowed CORS origin for the backend (Vercel frontend URL in prod)
FRONTEND_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Frontend API wiring
# -----------------------------------------------------------------------------

# Local dev: point Vite at the local FastAPI server.
# Production Vercel: set VITE_API_URL to an empty string so the app calls
# same-origin /api/* routes, which are proxied to Railway by vercel.json.
VITE_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# External Data Sources
# -----------------------------------------------------------------------------

# Garmin Connect credentials. Do not commit real values.
# garminconnect persists OAuth tokens under GARMIN_TOKENSTORE after login; the
# password itself is not written by the app.
GARMIN_EMAIL=your-garmin-email
GARMIN_PASSWORD=your-garmin-password
GARMIN_TOKENSTORE=~/.garminconnect
# Optional secret-backed token blob for hosted deployments where the filesystem
# tokenstore is ephemeral. Generate with scripts/bootstrap_garmin_tokenstore.py.
GARMIN_TOKENSTORE_B64=

# Hive credentials. Do not commit real values.
HIVE_EMAIL=your-hive-email
HIVE_PASSWORD=your-hive-password
# Hive uses AWS Cognito SMS_MFA, so password login cannot run headlessly. Seed
# this base64 {username, refresh_token} blob once via a SMS-2FA login with
# scripts/bootstrap_hive_tokenstore.py; the poller then resumes unattended.
HIVE_TOKENSTORE_B64=

# Open-Meteo defaults for Kilmarnock (KA1 2SD).
WEATHER_LATITUDE=55.6045
WEATHER_LONGITUDE=-4.5249
WEATHER_TIMEZONE=Europe/London

# Anthropic API key — used by analysis engine.
# Production (the Railway `api` service) sets ANTHROPIC_API_KEY and *nothing else*
# here, so every other value below is the code default in `config.py`. The numbers
# in this file are the real ones for that reason: before Batch 233 this documented
# ANTHROPIC_MAX_TOKENS=1600, a value production has never used and which under
# Sonnet 5 would truncate the first morning brief — a fresh environment built from
# this file would have failed immediately, for a reason this file itself caused.
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5
# Caps thinking and text *together* — and on Sonnet 5 thinking dominates. This
# is a THINKING budget, not a prose budget: measured demand is ~16k output tokens
# at effort=high and ~5.3k at medium, of which prose is only ~1.5k either way.
# Deliberately sized for `high` even though the app ships `medium`, so effort is
# a dial that can move on its own; a ceiling costs nothing unless it is reached.
# Raising it moves the read budget below — mind the 600s wall.
ANTHROPIC_MAX_TOKENS=24576
# Batch 233.2: the chat and conversation-learning ceilings, which used to be
# hardcoded at 1024 and 1800 where no environment variable could reach them.
ANTHROPIC_CHAT_MAX_TOKENS=4096
ANTHROPIC_LEARNING_MAX_TOKENS=4096
# Batch 233.3: `adaptive` or `disabled`; effort is one of low|medium|high|xhigh|max.
# `disabled` restores Sonnet 4.6's behaviour byte-for-byte if a live morning
# regresses. An unrecognised value fails at startup rather than on Mark's brief.
#
# Effort is the steepest cost lever here: `high` generates 3.1x the output tokens
# of `medium` on the same packet (16,157 vs 5,280) — ~$0.21/run against ~$0.11,
# i.e. +126% vs today's Sonnet 4.6 against only +11%. `medium` buys adaptive
# thinking for roughly what the app already pays. Raise it only once the prose
# comparison (Batch 233.8) shows `high` earns the difference.
ANTHROPIC_THINKING_MODE=adaptive
ANTHROPIC_EFFORT=medium

# How long to wait for a *complete* non-streamed Messages response (Batch 234).
# The morning brief measured 75.1s on 2026-08-30 and 139s on regeneration, so a
# flat 60s ceiling threw away answers Anthropic had already generated and billed.
# The generation lease is derived from this value plus the overhead below, and
# the app refuses to start if the result does not outlive both this budget and
# the database's statement timeout while still expiring before the UI calls a
# generation stale (Batch 232.2). Batch 233.6 re-derived it from the raised
# ceiling and re-based the rate on measured throughput (87–99 tok/s observed,
# derived at a pessimistic 45): 24576 / 45 ≈ 546s. **Hard wall at 600s** — at or
# above it the derived lease no longer expires before the 720s stale-after guard and the API
# refuses to boot.
ANTHROPIC_READ_TIMEOUT_SECONDS=550
GENERATION_LEASE_OVERHEAD_SECONDS=120

# intervals.icu delivery rail — output only, used to push approved structured
# workouts into the intervals.icu calendar that syncs to Zwift.
INTERVALS_API_KEY=your-intervals-api-key
INTERVALS_ATHLETE_ID=i618709
INTERVALS_BASE_URL=https://intervals.icu/api/v1

# -----------------------------------------------------------------------------
# Error Tracking (Sentry) — optional
# -----------------------------------------------------------------------------

SENTRY_DSN_BACKEND=
VITE_SENTRY_DSN=

# -----------------------------------------------------------------------------
# CI / Tooling
# -----------------------------------------------------------------------------

# GitHub personal access token — used by phase close-out to poll CI status
GITHUB_TOKEN=your-github-personal-access-token
